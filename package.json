{
  "name": "dsh-feishu-notifier",
  "version": "0.3.4",
  "description": "在智能体请求批准、等待你回答或一轮对话结束时，向飞书自定义机器人推送 Markdown 卡片通知；Webhook 以密钥形式保存在 DSH 设置中，可在设置页就地发送测试消息。",
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blooming-fang/dsh-feishu-notifier.git"
  },
  "homepage": "https://github.com/blooming-fang/dsh-feishu-notifier#readme",
  "bugs": {
    "url": "https://github.com/blooming-fang/dsh-feishu-notifier/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "docs",
    "cordis.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "feishu",
    "notification",
    "bot",
    "lark"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "smoke": "node ./scripts/smoke.mjs",
    "pack:check": "pnpm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.0-rc.1",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "semver": "^7.8.5",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
